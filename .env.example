# Riot API キー（Personal API Key。24時間で期限切れ→再生成して書き換え）
# https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 自分の Riot ID（引数なし実行で自分の直近試合を自動取得・強調表示に使用）
# ゲーム内で表示される「名前#タグ」の两部分を設定してください（任意）。
MY_GAME_NAME=
MY_TAG_LINE=
# account-v1 / match-v5 の大陸ルーティング（JP/KR=asia, NA/BR/LA/OC=americas, EU/TR/RU=europe）
MY_REGION=asia
# 表示用サーバー
MY_SERVER=JP
